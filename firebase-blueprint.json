{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil pengguna yang terautentikasi melalui Google Sign-In.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID pemilik profil" },
        "displayName": { "type": "string", "description": "Nama tampilan pengguna" },
        "username": { "type": "string", "description": "Username unik huruf kecil 3-20 karakter" },
        "email": { "type": "string", "description": "Alamat email pengguna (privat)" },
        "photoUrl": { "type": "string", "description": "URL foto profil opsional" },
        "activeTenantId": { "type": "string", "description": "ID organisasi aktif saat ini" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Diisi FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Diisi FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "displayName", "email", "createdAt", "updatedAt"]
    },
    "Tenant": {
      "title": "Tenant",
      "description": "Organisasi / workspace SaaS multi-tenant.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "ownerId": { "type": "string" },
        "memberUids": { "type": "array" },
        "adminUids": { "type": "array" },
        "aiMode": { "type": "string", "enum": ["platform", "byok"] },
        "watermarkEnabled": { "type": "boolean" },
        "maxFileMb": { "type": "integer" },
        "retentionDays": { "type": "integer" },
        "monthlyBudgetUsd": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "ownerId", "memberUids", "adminUids", "aiMode", "watermarkEnabled", "maxFileMb", "retentionDays", "monthlyBudgetUsd", "status", "createdAt", "updatedAt"]
    },
    "TenantMember": {
      "title": "TenantMember",
      "description": "Keanggotaan dan peran pengguna dalam suatu tenant.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "tenantId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "admin", "member"] },
        "memberStatus": { "type": "string", "enum": ["active", "disabled"] },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "tenantId", "displayName", "email", "role", "memberStatus", "memberUids", "createdAt", "updatedAt"]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "Dokumen rapat beserta transkrip, notulen AI, analisis, dan data visual.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "userId": { "type": "string" },
        "ownerName": { "type": "string" },
        "judul": { "type": "string" },
        "status": { "type": "string", "enum": ["uploaded", "transcribing", "summarizing", "done", "error"] },
        "errorMessage": { "type": "string" },
        "durasiDetik": { "type": "integer" },
        "ukuranBytes": { "type": "integer" },
        "localAudioPath": { "type": "string" },
        "consentRecordedAt": { "type": "string", "format": "date-time" },
        "visibleToUids": { "type": "array" },
        "sharedWithAll": { "type": "boolean" },
        "bahasa": { "type": "string" },
        "transcriptText": { "type": "string" },
        "segments": { "type": "array" },
        "ringkasan": { "type": "string" },
        "poinUtama": { "type": "array" },
        "keputusan": { "type": "array" },
        "risiko": { "type": "array" },
        "angkaKunci": { "type": "array" },
        "actionItems": { "type": "array" },
        "analysis": { "type": "object" },
        "visualData": { "type": "object" },
        "modelInfo": { "type": "object" },
        "isFavorite": { "type": "boolean" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tenantId", "userId", "ownerName", "judul", "status", "durasiDetik", "ukuranBytes", "consentRecordedAt", "visibleToUids", "sharedWithAll", "bahasa", "transcriptText", "segments", "ringkasan", "poinUtama", "keputusan", "risiko", "angkaKunci", "actionItems", "createdAt", "updatedAt"]
    },
    "QaMessage": {
      "title": "QaMessage",
      "description": "Pesan percakapan tanya jawab AI lintas rapat.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "userId": { "type": "string" },
        "scope": { "type": "string", "enum": ["meeting", "all"] },
        "meetingId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "isi": { "type": "string" },
        "sumber": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tenantId", "userId", "scope", "role", "isi", "sumber", "createdAt", "updatedAt"]
    },
    "TaskConfig": {
      "title": "TaskConfig",
      "description": "Konfigurasi model AI per tugas untuk organisasi.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "task": { "type": "string", "enum": ["audio_transcription", "meeting_summary", "meeting_analysis", "meeting_qa", "action_item_extraction", "transcript_correction", "structured_visual_data"] },
        "providerLabel": { "type": "string" },
        "modelId": { "type": "string" },
        "connectionId": { "type": "string" },
        "routingMode": { "type": "string", "enum": ["manual", "auto"] },
        "fallbackConnectionId": { "type": "string" },
        "fallbackModelId": { "type": "string" },
        "timeoutSec": { "type": "integer" },
        "retryCount": { "type": "integer" },
        "temperature": { "type": "number" },
        "maxOutputTokens": { "type": "integer" },
        "enabled": { "type": "boolean" },
        "systemPromptOverride": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tenantId", "task", "providerLabel", "modelId", "temperature", "maxOutputTokens", "enabled", "systemPromptOverride", "memberUids", "createdAt", "updatedAt"]
    },
    "UsageLog": {
      "title": "UsageLog",
      "description": "Catatan metadata penggunaan AI/STT tanpa isi rapat.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "userId": { "type": "string" },
        "meetingId": { "type": "string" },
        "task": { "type": "string" },
        "kind": { "type": "string", "enum": ["ai", "stt"] },
        "provider": { "type": "string" },
        "modelId": { "type": "string" },
        "status": { "type": "string", "enum": ["ok", "error", "fallback"] },
        "inputTokens": { "type": "integer" },
        "outputTokens": { "type": "integer" },
        "audioSeconds": { "type": "integer" },
        "latencyMs": { "type": "integer" },
        "estimatedCostUsd": { "type": "number" },
        "playgroundMode": { "type": "boolean" },
        "adminUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tenantId", "userId", "task", "kind", "provider", "modelId", "status", "inputTokens", "outputTokens", "audioSeconds", "latencyMs", "estimatedCostUsd", "playgroundMode", "adminUids", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Jejak audit administratif organisasi tanpa data rahasia.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "userId": { "type": "string" },
        "actorEmail": { "type": "string" },
        "aksi": { "type": "string" },
        "target": { "type": "string" },
        "detail": { "type": "string" },
        "adminUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tenantId", "userId", "actorEmail", "aksi", "target", "detail", "adminUids", "createdAt"]
    },
    "ModelPrice": {
      "title": "ModelPrice",
      "description": "Daftar tarif token manual per model AI.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "provider": { "type": "string" },
        "modelId": { "type": "string" },
        "inputPer1M": { "type": "number" },
        "outputPer1M": { "type": "number" },
        "currency": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tenantId", "provider", "modelId", "inputPer1M", "outputPer1M", "currency", "memberUids", "createdAt", "updatedAt"]
    },
    "TenantInvite": {
      "title": "TenantInvite",
      "description": "Undangan bergabung ke organisasi.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "member"] },
        "token": { "type": "string" },
        "inviteStatus": { "type": "string", "enum": ["pending", "accepted", "revoked"] },
        "invitedBy": { "type": "string" },
        "adminUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tenantId", "email", "role", "token", "inviteStatus", "invitedBy", "adminUids", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Profil pengguna privat per UID."
    },
    "/tenants/{tenantId}": {
      "schema": { "$ref": "#/entities/Tenant" },
      "description": "Workspace organisasi multi-tenant."
    },
    "/tenants/{tenantId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/TenantMember" },
      "description": "Daftar anggota organisasi beserta perannya."
    },
    "/tenants/{tenantId}/meetings/{meetingId}": {
      "schema": { "$ref": "#/entities/Meeting" },
      "description": "Rapat, transkrip, notulen AI, analisis, dan data visual."
    },
    "/tenants/{tenantId}/qaMessages/{msgId}": {
      "schema": { "$ref": "#/entities/QaMessage" },
      "description": "Riwayat tanya jawab AI milik pengguna dalam tenant."
    },
    "/tenants/{tenantId}/taskConfigs/{taskId}": {
      "schema": { "$ref": "#/entities/TaskConfig" },
      "description": "Konfigurasi routing model AI per tugas."
    },
    "/tenants/{tenantId}/usageLogs/{logId}": {
      "schema": { "$ref": "#/entities/UsageLog" },
      "description": "Log penggunaan metadata AI dan audio."
    },
    "/tenants/{tenantId}/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Log audit aksi sensitif organisasi."
    },
    "/tenants/{tenantId}/modelPrices/{priceId}": {
      "schema": { "$ref": "#/entities/ModelPrice" },
      "description": "Tarif manual per 1 juta token yang diatur admin."
    },
    "/tenants/{tenantId}/invites/{inviteId}": {
      "schema": { "$ref": "#/entities/TenantInvite" },
      "description": "Undangan email untuk bergabung ke organisasi."
    }
  }
}
